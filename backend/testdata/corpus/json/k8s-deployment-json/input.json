{
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
        "name": "booking-api",
        "labels": {"app": "booking-api"}
    },
    "spec": {
        "replicas": 2,
        "template": {
            "spec": {
                "containers": [
                    {
                        "name": "api",
                        "image": "registry.example.com/booking-api:1.8.0",
                        "ports": [{"containerPort": 8080}]
                    }
                ]
            }
        }
    }
}
