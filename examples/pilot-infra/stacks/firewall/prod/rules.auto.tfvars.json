{
  "rules": [
    {
      "name": "frontend-to-api",
      "owner": "carol",
      "description": "Booking front-end to its API",
      "protocol": "tcp",
      "sources": ["10.20.1.0/24"],
      "destinations": ["10.20.1.20/32"],
      "ports": [443]
    },
    {
      "name": "api-to-payments",
      "owner": "bob",
      "protocol": "tcp",
      "sources": ["10.20.1.0/24"],
      "destinations": ["10.20.2.0/24"],
      "ports": [8443]
    },
    {
      "name": "deny-dev-to-prod",
      "owner": "alice",
      "description": "Nothing in dev reaches prod",
      "action": "deny",
      "protocol": "tcp",
      "sources": ["10.120.0.0/16"],
      "destinations": ["10.20.0.0/16"],
      "ports": [22, 443, 5432, 8443]
    }
  ]
}
