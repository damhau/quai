{
  "rules": [
    {
      "name": "frontend-to-api",
      "owner": "carol",
      "description": "Booking front-end to its API",
      "protocol": "tcp",
      "sources": ["10.120.1.0/24"],
      "destinations": ["10.120.1.20/32"],
      "ports": [443]
    },
    {
      "name": "api-to-payments",
      "owner": "bob",
      "protocol": "tcp",
      "sources": ["10.120.1.0/24"],
      "destinations": ["10.120.2.0/24"],
      "ports": [8443]
    },
    {
      "name": "monitoring-ping",
      "owner": "alice",
      "description": "The monitoring agents ping every host",
      "protocol": "icmp",
      "sources": ["10.100.0.0/24"],
      "destinations": ["10.120.0.0/16"]
    }
  ]
}
