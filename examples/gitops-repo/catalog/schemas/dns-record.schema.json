{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/dns-record.schema.json",
  "title": "DNS record set",
  "description": "An entry of the records map in dns/<zone>/records.auto.tfvars, as the zone's stack accepts it.",
  "type": "object",
  "required": ["owner", "type", "values"],
  "additionalProperties": false,
  "properties": {
    "owner": { "type": "string", "title": "Owner" },
    "type": { "type": "string", "title": "Type", "enum": ["A", "AAAA", "CNAME", "TXT"], "default": "A" },
    "ttl": { "type": "integer", "title": "TTL (seconds)", "minimum": 60, "maximum": 86400, "default": 300 },
    "values": {
      "type": "array",
      "title": "Values",
      "description": "IPv4 addresses for an A record, IPv6 for AAAA, one host name for a CNAME.",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "CNAME" } }, "required": ["type"] },
      "then": { "properties": { "values": { "maxItems": 1 } } }
    },
    {
      "if": { "properties": { "type": { "const": "A" } }, "required": ["type"] },
      "then": { "properties": { "values": { "items": { "format": "ipv4" } } } }
    }
  ]
}
